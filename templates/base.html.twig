<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Plateforme Suivi Demande des Projets{% endblock %}</title>
        <link rel="icon" href="data:image/,">
        {% block stylesheets %}
        <style>
            :root {
                --omrane-red: #E2231A;
                --omrane-green: #0F6B3A;
                --bg: #f4f6f5;
            }
            * { box-sizing: border-box; }
            body {
                font-family: Arial, Helvetica, sans-serif;
                margin: 0;
                background: var(--bg);
                color: #222;
            }
            header {
                background: white;
                border-bottom: 4px solid var(--omrane-green);
                padding: 15px 30px;
                display: flex;
                align-items: center;
                gap: 15px;
            }
            header img { height: 50px; }
            header h1 {
                font-size: 20px;
                margin: 0;
                color: var(--omrane-green);
            }
            header nav {
                margin-left: auto;
                display: flex;
                align-items: center;
                gap: 20px;
            }
            header nav a {
                text-decoration: none;
                color: var(--omrane-red);
                font-weight: bold;
            }
            .btn-primary {
                background: var(--omrane-red);
                color: white;
                border: none;
                padding: 10px 22px;
                border-radius: 6px;
                cursor: pointer;
                font-size: 15px;
            }
            .btn-primary:hover { background: var(--omrane-green); }
            table {
                width: 100%;
                border-collapse: collapse;
                background: white;
            }
            table th, table td {
                border: 1px solid #ddd;
                padding: 10px;
                text-align: left;
            }
            table th {
                background: var(--omrane-green);
                color: white;
            }
            .layout {
                display: flex;
                align-items: flex-start;
                min-height: calc(100vh - 82px);
            }
            .sidebar {
                width: 220px;
                flex-shrink: 0;
                background: white;
                border-right: 1px solid #ddd;
                padding: 20px 15px;
                min-height: calc(100vh - 82px);
            }
            .sidebar .btn-create {
                display: block;
                width: 100%;
                text-align: center;
                text-decoration: none;
                background: var(--omrane-red);
                color: white;
                font-weight: bold;
                padding: 12px;
                border-radius: 6px;
                margin-bottom: 25px;
            }
            .sidebar .btn-create:hover { background: var(--omrane-green); }
            .sidebar-link {
                display: block;
                padding: 10px 12px;
                border-radius: 6px;
                text-decoration: none;
                color: #333;
                font-weight: bold;
                margin-bottom: 4px;
            }
            .sidebar-link:hover { background: var(--bg); }
            .sidebar-section-title {
                text-transform: uppercase;
                font-size: 12px;
                color: #888;
                margin: 20px 0 8px 12px;
                letter-spacing: 0.5px;
            }
            .sidebar-sublink {
                display: block;
                padding: 8px 12px 8px 24px;
                text-decoration: none;
                color: #555;
                border-radius: 6px;
                margin-bottom: 2px;
                font-size: 14px;
            }
            .sidebar-sublink:hover { background: var(--bg); }
            .sidebar-sublink.active {
                background: #e8f3ee;
                color: var(--omrane-green);
                font-weight: bold;
            }
            .content {
                flex: 1;
                min-width: 0;
            }
            .sidebar-search {
                padding: 0 12px;
                display: flex;
                gap: 6px;
            }
            .sidebar-search input[type="text"] {
                flex: 1;
                min-width: 0;
                padding: 7px 9px;
                border: 1px solid #ccc;
                border-radius: 6px;
                font-size: 13px;
            }
            .sidebar-search button {
                background: var(--omrane-green);
                color: white;
                border: none;
                border-radius: 6px;
                padding: 0 10px;
                cursor: pointer;
                font-size: 14px;
            }
            .sidebar-search button:hover { background: var(--omrane-red); }
        </style>
        {% endblock %}
    </head>
    <body>
        <header>
            <img src="{{ asset('images/logo.png') }}" alt="Al Omrane">
            <h1>Plateforme de Suivi Demande des Projets</h1>
            <nav>
                {% if app.user %}
                <span style="color:#555;">{{ app.user.userIdentifier }}</span>
                <a href="{{ path('app_logout') }}">Déconnexion</a>
                {% else %}
                <a href="{{ path('app_login') }}">Connexion</a>
                {% endif %}
            </nav>
        </header>
        <div class="layout">
            {% if app.user %}
            {% set qParam = app.request.query.get('q') %}
            {% set statutParam = app.request.query.get('statut') %}
            <aside class="sidebar">
                <a href="{{ path('app_demande') }}" class="btn-create">+ Demande</a>
                {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_users_index') }}" class="sidebar-link">Utilisateurs</a>
                {% endif %}
                <a href="{{ path('app_historique') }}" class="sidebar-link">Historique</a>

                <div class="sidebar-section-title">Recherche</div>
                <form method="get" action="{{ path('app_historique') }}" class="sidebar-search">
                    {% if statutParam %}
                        <input type="hidden" name="statut" value="{{ statutParam }}">
                    {% endif %}
                    <input type="text" name="q" value="{{ qParam }}" placeholder="N°, nom ou lien...">
                    <button type="submit" title="Rechercher">🔎</button>
                </form>

                <div class="sidebar-section-title">Statut</div>
                <a href="{{ path('app_historique', qParam ? {q: qParam} : {}) }}" class="sidebar-sublink{{ statutParam is empty ? ' active' : '' }}">Tous</a>
                <a href="{{ path('app_historique', ({statut: 'incomplet'}|merge(qParam ? {q: qParam} : {}))) }}" class="sidebar-sublink{{ statutParam == 'incomplet' ? ' active' : '' }}">Infos incomplètes</a>
                <a href="{{ path('app_historique', ({statut: 'termine'}|merge(qParam ? {q: qParam} : {}))) }}" class="sidebar-sublink{{ statutParam == 'termine' ? ' active' : '' }}">Terminé</a>
            </aside>
            {% endif %}
            <main class="content">
                {% block body %}{% endblock %}
            </main>
        </div>
    </body>
</html>