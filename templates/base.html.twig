<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Plateforme Suivi Demande des Projets{% endblock %}</title>
        <link rel="icon" href="data:image/,">
        {% block stylesheets %}
        <style>
            :root {
                --omrane-red: #E2231A;
                --omrane-green: #0F6B3A;
                --bg: #f4f6f5;
            }
            * { box-sizing: border-box; }
            body {
                font-family: Arial, Helvetica, sans-serif;
                margin: 0;
                background: var(--bg);
                color: #222;
            }
            header {
                background: white;
                border-bottom: 4px solid var(--omrane-green);
                padding: 15px 30px;
                display: flex;
                align-items: center;
                gap: 15px;
            }
            header img { height: 50px; }
            header h1 {
                font-size: 20px;
                margin: 0;
                color: var(--omrane-green);
            }
            header nav {
                margin-left: auto;
                display: flex;
                gap: 20px;
            }
            header nav a {
                text-decoration: none;
                color: var(--omrane-red);
                font-weight: bold;
            }
            .btn-primary {
                background: var(--omrane-red);
                color: white;
                border: none;
                padding: 10px 22px;
                border-radius: 6px;
                cursor: pointer;
                font-size: 15px;
            }
            .btn-primary:hover { background: var(--omrane-green); }
            table {
                width: 100%;
                border-collapse: collapse;
                background: white;
            }
            table th, table td {
                border: 1px solid #ddd;
                padding: 10px;
                text-align: left;
            }
            table th {
                background: var(--omrane-green);
                color: white;
            }
        </style>
        {% endblock %}
    </head>
    <body>
        <header>
            <img src="{{ asset('images/logo.png') }}" alt="Al Omrane">
            <h1>Plateforme de Suivi Demande des Projets</h1>
            <nav>
                <a href="{{ path('app_home') }}">Accueil</a>
                <a href="{{ path('app_demande') }}">Demande</a>
                <a href="{{ path('app_historique') }}">Historique</a>
                {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_users_index') }}">Utilisateurs</a>
                {% endif %}
                {% if app.user %}
                <span style="color:#555;">{{ app.user.userIdentifier }}</span>
                <a href="{{ path('app_logout') }}">Déconnexion</a>
                {% else %}
                <a href="{{ path('app_login') }}">Connexion</a>
                {% endif %}
            </nav>
        </header>
        <main>
            {% block body %}{% endblock %}
        </main>
    </body>
</html>