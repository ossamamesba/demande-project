{{ form_start(form) }}
    <div class="mb-3">
        {{ form_row(form.title) }}
    </div>
    <div class="mb-3">
        {{ form_row(form.description) }}
    </div>
    <div class="mb-3 form-check">
        {{ form_row(form.isDone) }}
    </div>
    <div class="mb-3">
        {{ form_row(form.createdAt) }}
    </div>

    <button class="btn btn-success">💾 Enregistrer</button>
{{ form_end(form) }}